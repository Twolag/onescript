# ============================================
# Fichier LOCAL uniquement — JAMAIS sur GitHub
# Remplace les valeurs ci-dessous par tes vraies clés
# ============================================

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY_HERE
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
VITE_STRIPE_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY_HERE

# URL du site (redirects Stripe success / cancel)
BASE_URL=https://onescript.fr

# Resend (emails)
RESEND_API_KEY=your_resend_api_key_here
ADMIN_EMAIL=your_admin_email@example.com

# Discord
DISCORD_LINK=https://discord.gg/5btq6znUvN
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Discord reviews sync (salon avis → site, validation ✅)
# Créer une app bot : https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_REVIEWS_CHANNEL_ID=your_reviews_channel_id
# IDs Discord des modos autorisés à valider (réaction ✅). Vide = n'importe qui avec ✅
DISCORD_REVIEW_APPROVER_IDS=123456789012345678,987654321098765432
REVIEWS_SYNC_SECRET=choose_a_long_random_secret
CRON_SECRET=choose_a_long_random_secret_for_vercel_cron
# Optionnel — sync auto sur Vercel sans commit (stockage images + JSON)
BLOB_READ_WRITE_TOKEN=
